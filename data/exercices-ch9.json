   "id": "ch9-menard",
   "titre": "Tassement pressiométrique en sol homogène",
   "difficulte": 2,
   "graine": 3004354549,
   "enonce": "Semelle carrée de largeur B = 2,5 m sur un sol homogène : EM = 18 MPa, α = 2/3. Sous la combinaison quasi permanente, q' = 236 kPa ; σ'v0 = 31 kPa au niveau de la base.",
   "donnees": [
    {
     "label": "Forme · B",
     "valeur": "carree · 2,5 m"
    },
    {
     "label": "EM · α",
     "valeur": "18 MPa · 2/3"
    },
    {
     "label": "q' − σ'v0",
     "valeur": "205 kPa"
    }
   ],
   "questions": [
    {
     "texte": "Coefficient λd ?",
     "type": "nombre",
     "unite": "",
     "reponse": 1.12,
     "explication": "L/B = 1,0 ⇒ λc = 1,10, λd = 1,12.",
     "toleranceRel": 0.005
    },
    {
     "texte": "Tassement sphérique sc ?",
     "type": "nombre",
     "unite": "mm",
     "reponse": 2.31996,
     "explication": "sc = α (q' − σ'v0) λc B / (9 EM) = 0,667 × 205 × 1,10 × 2,5 / (9 × 18 000) = 2,32 mm.",
     "toleranceRel": 0.02
    },
    {
     "texte": "Tassement déviatorique sd ?",
     "type": "nombre",
     "unite": "mm",
     "reponse": 4.24057,
     "explication": "sd = 2 (q' − σ'v0) B0 (λd B/B0)^α / (9 EM) = 2 × 205 × 0,6 × (4,667)^2/3 / (9 × 18 000) = 4,24 mm.",
     "toleranceRel": 0.02
    },
    {
     "texte": "Tassement final sf ?",
     "type": "nombre",
     "unite": "mm",
     "reponse": 6.56053,
     "explication": "sf = sc + sd = 6,56 mm.",
     "toleranceRel": 0.02
    }
   ]
  },

   ],
   "questions": [
    {
     "texte": "Module de réaction kv (charges de longue durée) ?",
     "type": "nombre",
     "unite": "MN/m³",
     "reponse": 40.1231,
     "explication": "1/kv = α λc B/(9 Ec) + (2 B0/9 Ed)(λd B/B0)^α avec λc = 1,10, λd = 1,12 : kv = 40,1 MN/m³.",
     "toleranceRel": 0.02
    },
    {
     "texte": "Module pour les charges de courte durée ki ?",
     "type": "nombre",
     "unite": "MN/m³",
     "reponse": 80.2463,
     "explication": "ki = 2 kv = 80,2 MN/m³ (F62 annexe F.3 § 4).",
     "toleranceRel": 0.02
    },
    {
     "texte": "Une semelle deux fois plus large sur le même sol aurait un module kv…",
     "type": "choix",
     "options": [
      "plus fort",
      "plus faible",
      "identique"
     ],
     "reponse": 1,
     "explication": "kv = q/s et le tassement croît avec B : le module de réaction n'est pas une propriété du sol, il diminue quand la fondation s'élargit."
    }
   ]

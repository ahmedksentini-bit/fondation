   "id": "ch2-cptu",
   "titre": "Une mesure au piézocône",
   "difficulte": 2,
   "graine": 1681439955,
   "enonce": "Au piézocône, à z = 14,0 m (γ = 18,5 kN/m³, nappe à 3,0 m, γw = 9,81 kN/m³), on lit qc = 8,50 MPa, fs = 50 kPa et u2 = 106 kPa. Le rapport de surfaces de la pointe vaut a = 0,85.",
   "donnees": [
    {
     "label": "z",
     "valeur": "14,0 m"
    },
    {
     "label": "qc",
     "valeur": "8,50 MPa"
    },
    {
     "label": "fs",
     "valeur": "50 kPa"
    },
    {
     "label": "u2",
     "valeur": "106 kPa"
    },
    {
     "label": "a",
     "valeur": "0,85"
    }
   ],
   "questions": [
    {
     "texte": "Résistance de pointe corrigée qt ?",
     "type": "nombre",
     "unite": "kPa",
     "reponse": 8515.9,
     "explication": "qt = qc + (1 − a) u2 = 8 500 + 0,15 × 106 = 8 515,9 kPa.",
     "toleranceRel": 0.01
    },
    {
     "texte": "Résistance normalisée Qt ?",
     "type": "nombre",
     "unite": "",
     "reponse": 54.6489,
     "explication": "σv0 = 259 kPa, u0 = 108 kPa ; Qt = (qt − σv0)/σ'v0 = 8 257/151,1 = 54,6.",
     "toleranceRel": 0.03
    },
    {
     "texte": "Rapport de frottement normalisé Fr (en %) ?",
     "type": "nombre",
     "unite": "%",
     "reponse": 0.605554,
     "explication": "Fr = fs/(qt − σv0) = 50/8 257 = 0,61 %.",
     "toleranceRel": 0.03
    },
    {
     "texte": "Indice de comportement Ic ?",
     "type": "nombre",
     "unite": "",
     "reponse": 2.0014,
     "explication": "Ic = √[(3,47 − log Qt)² + (log Fr + 1,22)²] = 2,00.",
     "tolerance": 0.05
    },
    {
     "texte": "Zone de comportement de Robertson ?",
     "type": "choix",
     "options": [
      "zone 7 : sable graveleux à sable dense",
      "zone 5 : mélange sableux : sable limoneux à limon sableux",
      "zone 2 : sol organique, tourbe",
      "zone 6 : sable propre à sable limoneux"
     ],
     "reponse": 3,
     "explication": "Ic = 2,00 : zone 6 : sable propre à sable limoneux. C'est un classement de comportement, non une granulométrie."
    }
   ]
  },

  {
   "id": "ch7-N",
   "titre": "Facteurs de portance",
   "difficulte": 1,
   "graine": 3691859268,
   "enonce": "Sol d'angle de frottement effectif φ' = 21°. On applique l'annexe D de l'EN 1997-1.",
   "donnees": [
    {
     "label": "φ'",
     "valeur": "21°"
    },
    {
     "label": "tan φ'",
     "valeur": "0,3839"
    }
   ],
   "questions": [
    {
     "texte": "Nq ?",
     "type": "nombre",
     "unite": "",
     "reponse": 7.07076,
     "explication": "Nq = e^(π tanφ') tan²(45° + φ'/2) = e^(1,2059) × tan²(55,5°) = 7,07.",
     "toleranceRel": 0.01
    },
    {
     "texte": "Nc ?",
     "type": "nombre",
     "unite": "",
     "reponse": 15.8149,
     "explication": "Nc = (Nq − 1) cotφ' = 6,071 / 0,3839 = 15,81.",
     "toleranceRel": 0.01
    },
    {
     "texte": "Nγ (base rugueuse) ?",
     "type": "nombre",
     "unite": "",
     "reponse": 4.6607,
     "explication": "Nγ = 2 (Nq − 1) tanφ' = 2 × 6,071 × 0,3839 = 4,66.",
     "toleranceRel": 0.01
    },
    {
     "texte": "Lequel de ces facteurs n'a pas de solution exacte ?",
     "type": "choix",
     "options": [
      "Nc",
      "Nq",
      "Nγ"
     ],
     "reponse": 2,
     "explication": "Nq et Nc sont exacts (Prandtl, Reissner) pour un sol sans poids ; Nγ, qui dépend du poids du sol mobilisé, n'a que des approximations — et varie de ± 25 % selon les auteurs."
    }
   ]
  },
  {
   "id": "ch7-nd",

   "id": "ch7-menard",
   "titre": "Tassement pressiométrique en sol homogène",
   "difficulte": 2,
   "graine": 2622998015,
   "enonce": "Semelle carrée de largeur B = 2,6 m sur un sol homogène : EM = 9 MPa, α = 2/3. Sous la combinaison quasi permanente, q' = 166 kPa ; σ'v0 = 26 kPa au niveau de la base.",
   "donnees": [
    {
     "label": "Forme · B",
     "valeur": "carree · 2,6 m"
    },
    {
     "label": "EM · α",
     "valeur": "9 MPa · 2/3"
    },
    {
     "label": "q' − σ'v0",
     "valeur": "140 kPa"
    }
   ],
   "questions": [
    {
     "texte": "Coefficient λd ?",
     "type": "nombre",
     "unite": "",
     "reponse": 1.12,
     "explication": "L/B = 1,0 ⇒ λc = 1,10, λd = 1,12.",
     "toleranceRel": 0.005
    },
    {
     "texte": "Tassement sphérique sc ?",
     "type": "nombre",
     "unite": "mm",
     "reponse": 3.29547,
     "explication": "sc = α (q' − σ'v0) λc B / (9 EM) = 0,667 × 140 × 1,10 × 2,6 / (9 × 9 000) = 3,30 mm.",
     "toleranceRel": 0.02
    },
    {
     "texte": "Tassement déviatorique sd ?",
     "type": "nombre",
     "unite": "mm",
     "reponse": 5.94544,
     "explication": "sd = 2 (q' − σ'v0) B0 (λd B/B0)^α / (9 EM) = 2 × 140 × 0,6 × (4,853)^2/3 / (9 × 9 000) = 5,95 mm.",
     "toleranceRel": 0.02
    },
    {
     "texte": "Tassement final sf ?",
     "type": "nombre",
     "unite": "mm",
     "reponse": 9.24092,
     "explication": "sf = sc + sd = 9,24 mm.",
     "toleranceRel": 0.02
    }
   ]
  },

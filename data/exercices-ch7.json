     "toleranceRel": 0.005
    },
    {
     "texte": "Facteur d'inclinaison ic ?",
     "type": "nombre",
     "unite": "",
     "reponse": 0.984432,
     "explication": "ic = ½ [1 + √(1 − H/(A' cu))] = ½ [1 + √(1 − 8/(1,74 × 75))] = 0,984.",
     "toleranceRel": 0.01
    },
    {
     "texte": "Contrainte de rupture brute R/A' ?",
     "type": "nombre",
     "unite": "kPa",
     "reponse": 413.816,
     "explication": "R/A' = (π + 2) cu ic + q = 5,142 × 75 × 0,984 + 34,2 = 413,8 kPa.",
     "toleranceRel": 0.01
    },
    {
     "texte": "Résistance de calcul Rd (approche 2, γR;v = 1,4) ?",
     "type": "nombre",
     "unite": "kN/m",
     "reponse": 514.314,
     "explication": "Rd = A' (R/A') / 1,4 = 1,74 × 413,8 / 1,4 = 514,3 kN/m ≥ Vd = 330 kN/m.",
     "toleranceRel": 0.015
    }
   ]
  },

     "type": "nombre",
     "unite": "kN/m",
     "reponse": 386.659,
     "explication": "Rd = A' (R/A') / 1,4 = 2,20 × 246,1 / 1,4 = 386,7 kN/m < Vd = 420 kN/m.",
     "toleranceRel": 0.015
    }
   ]

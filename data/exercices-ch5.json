  {
   "id": "ch5-N",
   "titre": "Facteurs de portance",
   "difficulte": 1,
   "graine": 3053605918,
   "enonce": "Sol d'angle de frottement effectif φ' = 38°. On applique l'annexe D de l'EN 1997-1.",
   "donnees": [
    {
     "label": "φ'",
     "valeur": "38°"
    },
    {
     "label": "tan φ'",
     "valeur": "0,7813"
    }
   ],
   "questions": [
    {
     "texte": "Nq ?",
     "type": "nombre",
     "unite": "",
     "reponse": 48.9333,
     "explication": "Nq = e^(π tanφ') tan²(45° + φ'/2) = e^(2,4545) × tan²(64,0°) = 48,93.",
     "toleranceRel": 0.01
    },
    {
     "texte": "Nc ?",
     "type": "nombre",
     "unite": "",
     "reponse": 61.3518,
     "explication": "Nc = (Nq − 1) cotφ' = 47,933 / 0,7813 = 61,35.",
     "toleranceRel": 0.01
    },
    {
     "texte": "Nγ (base rugueuse) ?",
     "type": "nombre",
     "unite": "",
     "reponse": 74.8991,
     "explication": "Nγ = 2 (Nq − 1) tanφ' = 2 × 47,933 × 0,7813 = 74,90.",
     "toleranceRel": 0.01
    },
    {
     "texte": "Lequel de ces facteurs n'a pas de solution exacte ?",
     "type": "choix",
     "options": [
      "Nc",
      "Nq",
      "Nγ"
     ],
     "reponse": 2,
     "explication": "Nq et Nc sont exacts (Prandtl, Reissner) pour un sol sans poids ; Nγ, qui dépend du poids du sol mobilisé, n'a que des approximations — et varie de ± 25 % selon les auteurs."
    }
   ]
  },
